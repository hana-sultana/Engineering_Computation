   "source": [
    "# Import the random,math,numpy and \n",
    "#matplotlib needed for this assignment\n",
    "import random as random\n",
    "import math\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 39,
   "id": "25fbe6f8-6691-47d9-82a9-7dbe19c4ff84",
   "metadata": {},
