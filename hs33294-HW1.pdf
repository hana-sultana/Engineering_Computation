   "source": [
    "\"\"\"\n",
    "This function estimates the value of pi \n",
    "using the Monte Carlo method.\n",
    "It generates random points inside a square from\n",
    "-1 to 1 on both axes.\n",
    "Points satisfying x*x + y*y < 1 are counted as being\n",
    "inside the unit circle.\n",
    "\"\"\"\n",
    "def approxiamtePI(numSamples):\n",
    "    counter = 0\n",
    "    for i in range(numSamples):\n",
    "        x = random.uniform(-1,1)\n",
    "        y = random.uniform(-1,1)\n",
    "        #print(x,y)\n",
    "        #This is used to see how many points are outside circle\n",
    "        if (x*x + y*y <1):\n",
    "            counter+=1\n",
    "    return 4.0 * counter/numSamples\n",
    "    \n",
    "#List to contain all the sample errors from 1-1000\n",
    "Sample_errors=[]\n",
    "\n",
    "\"\"\"\n",
    "This loop tests sample sizes from 10 to 1000 in steps of 20.\n",
    "For each sample size, the function returns an approximation of pi.\n",
    "The absolute difference between the approximated value and Python's\n",
    "value of pi is calculated and stored in the Sample_errors list.\n",
    "\"\"\"\n",
    "for i in range(10,1000,20):\n",
    "    error = abs(math.pi - approxiamtePI(i))\n",
    "    #print(error)\n",
    "    Sample_errors.append(error)\n",
    "print(Sample_errors)\n",
    "\n",
    "#This is for graphing the plot\n",
    "x = np.arange(10,1000,20)\n",
    "y = Sample_errors\n",
    "plt.plot(x,y)\n",
    "plt.xlabel(\"Samples\")\n",
    "plt.ylabel(\"Sample Errors\")\n",
    "plt.title(\"The Monte Carlo Pi\")\n",
    "plt.show()\n",
    "\n",
    "\n",
    "        \n",
